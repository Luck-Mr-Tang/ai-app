{
    "easycom": {
        "autoscan": true,
        "custom": {
            // "^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue",
            "^(?!z-paging-refresh|z-paging-load-more)z-paging(.*)": "z-paging/components/z-paging$1/z-paging$1.vue"
        }
    },
    // 在pages.json中为页面路由指定name字段后，即可以使用name跳转
    // 注意：此处定义的name字段必须全局唯一。
    "pages": [
        {
            "path": "pages/home/index",
            "name": "home",
            "meta": {
                "title": "首页",
                "isTab": true // 是否首层tab页
            },
            "style": {
                "navigationStyle": "custom",
                "navigationBarTextStyle": "white"
            }
        },
        {
          "path": "pages/cart/index",
          "name": "cart",
          "meta": {
              "title": "购物车",
              "isTab": true // 是否首层tab页
          },
          "style": {
              "navigationStyle": "custom",
              "navigationBarTextStyle": "white"
          }
      },
        {
            "path": "pages/user/index",
            "name": "user",
            "meta": {
                "islogin": false,
                "title": "我的",
                "isTab": true // 是否首层tab页
            },
            "style": {
                "navigationStyle": "custom",
                "enablePullDownRefresh": false,
                "app-plus": {
                    "scrollIndicator": "none"
                }
            }
        }
    ],
    "subPackages": [
        //分包加载
        {
            "root": "package-webview", //分包的根目录
            "pages": [
                //分包的页面列表
                {
                    "path": "pages/webview/index",
                    "name": "webview",
                    "meta": {
                        "title": "网页"
                    }
                }
            ]
        },
        {
            "root": "package-program", //分包的根目录
            "pages": [
                //分包的页面列表
                {
                    "path": "pages/search/index",
                    "name": "search",
                    "meta": {
                        "title": "项目搜索"
                    },
                    "style": {
                        "navigationStyle": "custom"
                    }
                }
            ]
        },
        {
            "root": "package-login",
            "pages": [
                {
                    "path": "pages/login/index",
                    "name": "login",
                    "meta": {
                        "islogin": false,
                        "title": "登录"
                    },
                    "style": {
                        "navigationStyle": "custom"
                    }
                },
                {
                    "path": "pages/findPwd/index",
                    "name": "findPwd",
                    "meta": {
                        "islogin": false,
                        "title": "修改密码"
                    },
                    "style": {
                        "navigationStyle": "custom"
                    }
                }
            ]
        },
        {
            "root": "package-ai",
            "pages": [
                {
                    "path": "pages/characters/index",
                    "name": "ai-characters",
                    "meta": {
                        "title": "AI 角色"
                    },
                    "style": {
                        "navigationStyle": "custom"
                    }
                },
                {
                    "path": "pages/chat/index",
                    "name": "ai-chat",
                    "meta": {
                        "title": "聊天"
                    },
                    "style": {
                        "navigationStyle": "custom"
                    }
                },
                {
                    "path": "pages/moments/index",
                    "name": "ai-moments",
                    "meta": {
                        "title": "动态广场"
                    },
                    "style": {
                        "navigationStyle": "custom"
                    }
                },
                {
                    "path": "pages/login/index",
                    "name": "ai-login",
                    "meta": {
                        "islogin": false,
                        "title": "选择账号"
                    },
                    "style": {
                        "navigationStyle": "custom"
                    }
                }
            ]
        },
        {
            "root": "package-register",
            "pages": [
                {
                    "path": "pages/register/index",
                    "name": "register",
                    "meta": {
                        "islogin": false,
                        "title": "注册",
                        "customSafeArea": true
                    },
                    "style": {
                        "navigationStyle": "custom"
                    }
                },
                {
                    "path": "pages/auditProcess/index",
                    "name": "auditProcess",
                    "meta": {
                        "islogin": true,
                        "title": "审核进度"
                    },
                    "style": {
                        "navigationBarTitleText": "审核进度",
                        "navigationStyle": "custom"
                    }
                }
            ]
        }
    ],
    "globalStyle": {
        "navigationBarTextStyle": "black",
        "navigationBarTitleText": "app",
        "navigationBarBackgroundColor": "#F8F8F8",
        "backgroundColor": "#F8F8F8"
    },
    // "mp-weixin"
    "optimization": {
        "subPackages": true //是否启用分包优化
    }
}
