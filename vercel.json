{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "installCommand": "npx --yes pnpm@9.1.4 install --no-frozen-lockfile",
    "buildCommand": "npx --yes pnpm@9.1.4 run build:h5",
    "outputDirectory": "dist/build/h5",
    "framework": null,
    "build": {
        "env": {
            "HUSKY": "0",
            "NODE_OPTIONS": "--max-old-space-size=4096"
        }
    },
    "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
    ]
}
